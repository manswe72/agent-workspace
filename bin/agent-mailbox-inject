#!/usr/bin/env python3
"""
agent-mailbox-inject — UserPromptSubmit hook → MCP mailbox check.

Runs as a Claude Code UserPromptSubmit hook. Queries the dashboard's
/api/mcp/messages endpoint for the calling agent's unread inbox and
prints a short markdown summary to stdout. Claude Code prepends a
UserPromptSubmit hook's stdout to the next turn as additional
context, so the agent sees "you have N unread messages" on its
next prompt without the user having to ask.

Agent identity is taken from AGENT_WORKSPACE_AGENT_ID when set (the
dashboard exports that for inline agents). When unset, falls back to
deriving the issue from the cwd (worktrees layout) so externally-
launched gnome-terminal tabs work too.

Fail-open: any error / missing port → exit 0 with no output, so a
stopped dashboard never breaks a user's prompt.
"""

from __future__ import annotations

import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

PORT = int(os.environ.get("AGENT_WORKSPACE_PORT", "0"))
TIMEOUT = 1.5


def derive_agent_from_cwd() -> str:
    """Same regex as agent-event-notify — extract <issue> from a
    ~/git/worktrees/<issue>/<repo> cwd."""
    m = re.search(r"[/\\]worktrees[/\\]([^/\\]+)", os.getcwd())
    return m.group(1) if m else ""


def fetch_unread(agent: str) -> list[dict]:
    url = (f"http://127.0.0.1:{PORT}/api/mcp/messages"
           f"?agent={urllib.parse.quote(agent)}&unread_only=1")
    req = urllib.request.Request(url, method="GET",
        headers={"User-Agent": "agent-mailbox-inject/1.0"})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        body = resp.read().decode("utf-8", errors="replace")
    data = json.loads(body)
    return list(data.get("messages") or [])


def format_summary(msgs: list[dict]) -> str:
    lines = [f"📬 You have {len(msgs)} unread message(s) in your "
             f"agent mailbox:"]
    for m in msgs[:20]:
        sender = m.get("from") or "?"
        kind = m.get("kind") or "message"
        payload = m.get("payload") or {}
        text = (payload.get("text") or payload.get("context") or "")
        text = text.replace("\n", " ").strip()
        if len(text) > 140:
            text = text[:137] + "…"
        ref = payload.get("ref")
        ref_part = f" [ref={ref}]" if ref else ""
        lines.append(f"  - #{m.get('id')} from {sender} ({kind})"
                     f"{ref_part}: {text}")
    if len(msgs) > 20:
        lines.append(f"  …and {len(msgs) - 20} more.")
    lines.append("Use the `read_messages` MCP tool to fetch + ack "
                 "them (it marks them read).")
    return "\n".join(lines)


def main() -> int:
    if not PORT:
        return 0  # no dashboard, no mailbox
    agent = (os.environ.get("AGENT_WORKSPACE_AGENT_ID") or "").strip()
    if not agent:
        agent = derive_agent_from_cwd()
    if not agent:
        return 0
    # Drain stdin so Claude Code doesn't see a broken pipe when it
    # writes the hook payload; we don't actually use it.
    try:
        if not sys.stdin.isatty():
            sys.stdin.read()
    except OSError:
        pass
    try:
        msgs = fetch_unread(agent)
    except (urllib.error.URLError, OSError, TimeoutError, ValueError):
        return 0  # fail-open
    if not msgs:
        return 0
    print(format_summary(msgs))
    return 0


if __name__ == "__main__":
    sys.exit(main())
